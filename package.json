{
  "name": "claxed",
  "author": "Tommaso Poletti",
  "version": "1.0.3",
  "license": "MIT",
  "main": "dist/claxed.cjs.js",
  "jsnext:main": "dist/claxed.esm.js",
  "module": "dist/claxed.esm.js",
  "types": "dist/index.d.ts",
  "browser": {
    "./dist/claxed.esm.js": "./dist/claxed.esm.js",
    "./dist/claxed.cjs.js": "./dist/claxed.cjs.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "scripts": {
    "start": "rollup -cw",
    "build": "rollup -c",
    "test": "jest"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "size-limit": [
    {
      "path": "dist/claxed.cjs.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/claxed.esm.js",
      "limit": "10 KB"
    }
  ],
  "peerDependencies": {
    "react": ">=16"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.4",
    "size-limit": "^13.0.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomma5o/claxed.git"
  },
  "keywords": [
    "react",
    "css",
    "classes",
    "components",
    "styling"
  ]
}
