{
  "name": "claxed",
  "author": "Tommaso Poletti",
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/claxed.cjs.js",
  "jsnext:main": "dist/claxed.esm.js",
  "module": "dist/claxed.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/claxed.esm.js",
      "require": "./dist/claxed.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "size-limit": [
    {
      "path": "dist/claxed.cjs.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/claxed.esm.js",
      "limit": "10 KB"
    }
  ],
  "peerDependencies": {
    "react": ">=16"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomma5o/claxed.git"
  },
  "keywords": [
    "react",
    "css",
    "classes",
    "components",
    "styling"
  ]
}
